    "Arm.R_end": [["Arm.R", "Arm.R_end"], ["Bip01 R UpperArm", "HandR_ref"]],
    "Leg.L":     [["Leg.L", "Leg.L_end"], ["Bip01 L Thigh", "Bip01 L Foot"]],
    "Leg.R":     [["Leg.R", "Leg.R_end"], ["Bip01 R Thigh", "Bip01 R Foot"]]
  },
